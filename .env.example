# Copy to `.env` at the repo root. Spring Boot loads it on startup. Do not commit real keys.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_JWK_SET_URI=

# Local: transaction pooler, port 6543, with prepareThreshold=0.
# Production (Railway env, not Vercel): same host and user, port 5432, no prepareThreshold.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=2

GROQ_API_KEY=
